{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OrcaxNet/ai-video-series-workflow/docs/flo-110/generation-manifest.schema.json",
  "title": "FLO-110 Generation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "evidence",
    "shot_id",
    "request_id",
    "idempotency_key",
    "modality",
    "prompt_snapshot_id",
    "context",
    "input_assets",
    "requested_output",
    "provider",
    "attempt",
    "status",
    "usage",
    "budget"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "evidence": {"enum": ["mock_only", "live_provider_call"]},
    "shot_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "modality": {"enum": ["text", "image", "video", "audio"]},
    "prompt_snapshot_id": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series_snapshot_id", "episode_snapshot_id", "scene_snapshot_id", "shot_snapshot_id"],
      "properties": {
        "series_snapshot_id": {"type": "string", "minLength": 1},
        "episode_snapshot_id": {"type": "string", "minLength": 1},
        "scene_snapshot_id": {"type": "string", "minLength": 1},
        "shot_snapshot_id": {"type": "string", "minLength": 1}
      }
    },
    "input_revision_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "input_assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "requested_output": {"$ref": "#/$defs/output"},
    "model_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_alias", "provider", "model_id", "route_version", "capability_hash", "verification"],
      "properties": {
        "capability_alias": {"enum": ["text.primary", "image.primary", "video.primary", "speech.primary"]},
        "provider": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "endpoint_id": {"type": "string"},
        "route_version": {"type": "string", "minLength": 1},
        "capability_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "verification": {"type": "string", "minLength": 1}
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "decision_id", "binding_id", "binding_hash", "actor_id"],
        "properties": {
          "gate": {"enum": ["G1", "G2", "G3"]},
          "decision_id": {"type": "string", "minLength": 1},
          "binding_id": {"type": "string", "minLength": 1},
          "binding_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "actor_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "region", "request_id", "job_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1},
        "job_id": {"type": "string", "minLength": 1}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "started_at", "completed_at", "latency_millis"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "latency_millis": {"type": "integer", "minimum": 1}
      }
    },
    "status": {"enum": ["succeeded", "failed", "cancelled"]},
    "actual_output": {"$ref": "#/$defs/output"},
    "output_assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "video_tokens": {"type": "integer", "minimum": 0},
        "generated_images": {"type": "integer", "minimum": 0},
        "generated_chars": {"type": "integer", "minimum": 0},
        "generated_millis": {"type": "integer", "minimum": 0},
        "provider_cost_micros": {"type": "integer", "minimum": 0}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimated_cost_micros", "max_cost_micros", "max_attempts"],
      "properties": {
        "estimated_cost_micros": {"type": "integer", "minimum": 0},
        "max_cost_micros": {"type": "integer", "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1}
      }
    },
    "error": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "modality": {"const": "video"},
          "status": {"const": "succeeded"}
        },
        "required": ["modality", "status"]
      },
      "then": {
        "required": ["actual_output", "output_assets"],
        "properties": {
          "actual_output": {
            "required": ["resolution", "aspect_ratio", "fps", "duration_millis", "format"]
          }
        }
      }
    }
  ],
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "kind", "role", "sha256", "license_reference"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "kind": {"enum": ["text", "image", "video", "audio"]},
        "role": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "license_reference": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "resolution": {"type": "string"},
        "aspect_ratio": {"type": "string"},
        "fps": {"type": "integer", "minimum": 1},
        "duration_millis": {"type": "integer", "minimum": 1},
        "format": {"type": "string"},
        "generate_audio": {"type": "boolean"}
      }
    }
  }
}
