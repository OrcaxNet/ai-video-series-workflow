# Local-only no-GPU/no-key video-pipeline Compose settings.
# Copy to video-pipeline/.env.video. Never place model provider credentials here;
# inject provider secrets explicitly at runtime or through a Secret Store.

VIDEO_BUILD_VERSION=dev
VIDEO_CONTROL_PLANE_PORT=18080
VIDEO_MOCK_PROVIDER_PORT=8090
VIDEO_POSTGRES_PORT=55432
VIDEO_TEMPORAL_PORT=7233
VIDEO_TEMPORAL_UI_PORT=8233

# Deliberately non-secret local development credentials. Production injects a
# secret-managed value at runtime; it is never committed to the repository.
VIDEO_POSTGRES_USER=video
VIDEO_POSTGRES_PASSWORD=video-local-only
VIDEO_POSTGRES_DATABASE=video_pipeline

# Live mode is opt-in: run Compose with --profile live and inject ARK_API_KEY
# plus VIDEO_PROVIDER_SERVICE_AUTH_SECRET in the invoking process. Never write
# either secret into this file. The live Adapter has no host-published port.
# VIDEO_PROVIDER_ADAPTER_URL=http://volcengine-provider:8091
# VIDEO_SPEECH_PROVIDER_ADAPTER_URL=http://mock-provider:8090
# Failed synchronous TTS is retried only by explicitly injecting both the exact
# speech job ID and the SHA-256 of its current prompt-free provider record.
# Leave these unset during normal operation.
# VIDEO_VOLCENGINE_TTS_RETRY_JOB_ID=speech-...
# VIDEO_VOLCENGINE_TTS_RETRY_RECORD_SHA256=<64 lowercase hex characters>
# The formal Stage 1 execution package is sealed separately and mounted from
# the protected artifact volume; caller-reported authorization state is never
# accepted through this environment file.
